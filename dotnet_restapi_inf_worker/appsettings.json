{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RestApi": {
    "Scheme": "https",
    "Host": "localhost",
    "Port": 443,
    "Token": "replace-with-api-token",
    "InputDataPath": "/api/input-data",
    "SimulationResultPath": "/api/simulation-results",
    "TimeoutSeconds": 30
  },
  "PostgreSql": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "simulation",
    "Username": "postgres",
    "Password": "replace-with-database-password",
    "SearchPath": "public",
    "SslMode": "Prefer",
    "TimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30,
    "Pooling": true,
    "MinPoolSize": 0,
    "MaxPoolSize": 100,
    "KeepAliveSeconds": 30,
    "ApplicationName": "DotnetRestApiInfWorker",
    "AdditionalOptions": {
      "Include Error Detail": "false"
    }
  },
  "InputDataCollector": {
    "Enabled": true,
    "MinuteOfHour": 10
  },
  "SimulationResultPublisher": {
    "Enabled": true,
    "ItervalSeconds": 30
  }
}
