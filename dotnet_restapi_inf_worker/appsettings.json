{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "InputDataCollector": {
    "Enabled": true,
    "PayloadToDtDelayMin": 30,
    "PayloadDtRangeMin": 10,
    "PayloadDtType": "<data-type>",
    "PayloadDataKind": "<data-kind>",
    "RequestPath": "https://localhost:443/api/input-data",
    "RequestToken": "replace-with-input-data-api-token",
    "RequestIntervalSec": 600,
    "RequestTimeoutSec": 30
  },
  "SimulationResultPublisher": {
    "Enabled": true,
    "ItervalSeconds": 30,
    "RequestPath": "https://localhost:443/api/simulation-results",
    "RequestToken": "replace-with-simulation-result-api-token",
    "RequestTimeoutSec": 30
  },
  "PostgreSql": {
    "Host": "localhost",
    "Port": 5432,
    "Database": "simulation",
    "Username": "postgres",
    "Password": "replace-with-database-password",
    "SearchPath": "public",
    "SslMode": "Prefer",
    "TimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30,
    "Pooling": true,
    "MinPoolSize": 0,
    "MaxPoolSize": 100,
    "KeepAliveSeconds": 30,
    "ApplicationName": "DotnetRestApiInfWorker",
    "AdditionalOptions": {
      "Include Error Detail": "false"
    }
  }
}
